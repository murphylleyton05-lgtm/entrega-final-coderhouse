# Copiá este archivo a ".env" y completá lo que uses.
# El pipeline funciona SIN estas claves (usa fallbacks), pero con ellas mejora.

# --- IA (guiones y metadata con Claude) ---
# Conseguila en https://console.anthropic.com  (sin ella se usan plantillas offline)
ANTHROPIC_API_KEY=

# --- B-roll de video real (opcional) ---
# API key gratis de https://www.pexels.com/api/  (sin ella se usa un fondo con gradiente animado)
PEXELS_API_KEY=

# --- Subida a YouTube (opcional) ---
# No es una clave suelta: descargá "client_secret.json" desde Google Cloud Console
# (OAuth 2.0, tipo "Desktop app") y guardalo en la carpeta credentials/.
# La primera subida abre el navegador para autorizar y crea credentials/token.json.
